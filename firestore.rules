rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access unless explicitly granted
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['id', 'title', 'createdAt', 'updatedAt', 'ownerId', 'questions']) &&
             data.id is string && isValidId(data.id) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.createdAt is number &&
             data.updatedAt is number &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.questions is list && data.questions.size() <= 200;
    }

    // Sessions collection for school-wide synchronization across all computers
    match /sessions/{sessionId} {
      // Anyone with the app link can read the shared sessions so all school computers sync immediately
      allow get, list: if true;
      
      // Allow create and update if session payload is structurally valid
      allow create: if isValidId(sessionId) &&
                    isValidSession(incoming()) &&
                    incoming().id == sessionId;
                    
      allow update: if isValidId(sessionId) &&
                    isValidSession(incoming()) &&
                    incoming().id == sessionId;
                    
      allow delete: if request.auth != null;
    }
  }
}
